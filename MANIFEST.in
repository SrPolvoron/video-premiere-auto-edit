include README.md README.es.md LICENSE AGENTS.md CONTRIBUTING.md SECURITY.md CHANGELOG.md
include pyproject.toml .gitignore .gitattributes .editorconfig
recursive-include docs *.md
recursive-include examples *.toml *.json
recursive-include scripts *.py *.ps1 *.sh
recursive-include tests *.py
recursive-include .github *.yml *.md
global-exclude *.py[cod]
prune work
prune models
prune tools
prune projects
prune .venv
